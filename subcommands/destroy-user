#!/usr/bin/env bash
source "$(dirname "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)")/config"
set -eo pipefail
[[ $DOKKU_TRACE ]] && set -x

service-destroy-user-cmd() {
  declare desc="destroy a user created in the $PLUGIN_SERVICE service"
  local cmd="$PLUGIN_COMMAND_PREFIX:destroy-user" argv=("$@")
  [[ ${argv[0]} == "$cmd" ]] && shift 1

  "${DOKKU_LIB_ROOT}/data/${PLUGIN_COMMAND_PREFIX}/dokku-datastore" destroy-user "$PLUGIN_COMMAND_PREFIX" "$@"
}

service-destroy-user-cmd "$@"
