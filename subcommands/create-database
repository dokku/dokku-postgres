#!/usr/bin/env bash
source "$(dirname "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)")/config"
set -eo pipefail
[[ $DOKKU_TRACE ]] && set -x

service-create-database-cmd() {
  declare desc="create a database in the $PLUGIN_SERVICE service"
  local cmd="$PLUGIN_COMMAND_PREFIX:create-database" argv=("$@")
  [[ ${argv[0]} == "$cmd" ]] && shift 1

  "${DOKKU_LIB_ROOT}/data/${PLUGIN_COMMAND_PREFIX}/dokku-datastore" create-database "$PLUGIN_COMMAND_PREFIX" "$@"
}

service-create-database-cmd "$@"
