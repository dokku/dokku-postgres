#!/usr/bin/env bash
source "$(dirname "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)")/config"
set -eo pipefail
[[ $DOKKU_TRACE ]] && set -x

service-set-user-password-cmd() {
  declare desc="change the password of a user created in the $PLUGIN_SERVICE service"
  local cmd="$PLUGIN_COMMAND_PREFIX:set-user-password" argv=("$@")
  [[ ${argv[0]} == "$cmd" ]] && shift 1

  "${DOKKU_LIB_ROOT}/data/${PLUGIN_COMMAND_PREFIX}/dokku-datastore" set-user-password "$PLUGIN_COMMAND_PREFIX" "$@"
}

service-set-user-password-cmd "$@"
