#!/usr/bin/env bash
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/config"
set -eo pipefail
[[ $DOKKU_TRACE ]] && set -x

# generated by dokku-datastore. do not edit: it is rewritten by make generate.
"${DOKKU_LIB_ROOT}/data/${PLUGIN_COMMAND_PREFIX}/dokku-datastore" trigger-pre-restore "$PLUGIN_COMMAND_PREFIX" "$@"
