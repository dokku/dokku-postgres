#!/usr/bin/env bash
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/config"
set -eo pipefail
[[ $DOKKU_TRACE ]] && set -x

plugin-post-app-rename-setup() {
  "${DOKKU_LIB_ROOT}/data/${PLUGIN_COMMAND_PREFIX}/dokku-datastore" trigger-post-app-rename-setup "$PLUGIN_COMMAND_PREFIX" "$@"
}

plugin-post-app-rename-setup "$@"
